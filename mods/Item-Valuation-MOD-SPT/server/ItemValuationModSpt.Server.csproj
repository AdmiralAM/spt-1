<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>Item Valuation MOD SPT Server</AssemblyName>
    <RootNamespace>ItemValuationModSpt.Server</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <SptRuntimeTarget>4.1.4</SptRuntimeTarget>
    <SptPublishedApiBaseline>4.1.4</SptPublishedApiBaseline>
  </PropertyGroup>

  <!-- SPT 4.1.4 is the sole canonical runtime and published API target. -->
  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="$(SptPublishedApiBaseline)" />
    <PackageReference Include="SPTushonka.DI" Version="$(SptPublishedApiBaseline)" />
    <PackageReference Include="SPTushonka.Server.Core" Version="$(SptPublishedApiBaseline)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\config\config.json" Link="config\config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
