<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>Item Valuation MOD SPT Server</AssemblyName>
    <RootNamespace>ItemValuationModSpt.Server</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <SptRuntimeTarget>4.1.3</SptRuntimeTarget>
    <SptPublishedApiBaseline>4.1.2</SptPublishedApiBaseline>
  </PropertyGroup>

  <!-- SPT 4.1.3 is the runtime target. The public SPTarkov NuGet feed currently
       provides the nearest server API baseline at 4.1.2; exact 4.1.3 behavior
       remains a runtime validation gate. -->
  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="$(SptPublishedApiBaseline)" />
    <PackageReference Include="SPTarkov.DI" Version="$(SptPublishedApiBaseline)" />
    <PackageReference Include="SPTarkov.Server.Core" Version="$(SptPublishedApiBaseline)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\config\config.json" Link="config\config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
