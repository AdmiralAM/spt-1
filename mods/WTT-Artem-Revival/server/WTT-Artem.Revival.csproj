<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WTTArtem</RootNamespace>
    <AssemblyName>WTT-Artem</AssemblyName>
    <Version>3.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WTT-ServerCommonLib" Version="3.0.4" />
  </ItemGroup>

  <Target Name="CopyArtemResources" AfterTargets="Build" Condition="Exists('$(ProjectDir)Resources')">
    <ItemGroup>
      <ArtemResources Include="$(ProjectDir)Resources\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(ArtemResources)"
      DestinationFiles="@(ArtemResources->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
