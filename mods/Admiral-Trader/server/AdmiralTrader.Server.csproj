<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>Admiral Trader Server</AssemblyName>
    <RootNamespace>AdmiralTrader.Server</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <SptRuntimeTarget>4.1.5</SptRuntimeTarget>
    <SptPublishedApiBaseline>4.1.5</SptPublishedApiBaseline>
    <UseExactSptRuntime Condition="'$(SptRuntimeLibDir)' != ''">true</UseExactSptRuntime>
    <UseExactSptRuntime Condition="'$(SptRuntimeLibDir)' == ''">false</UseExactSptRuntime>
  </PropertyGroup>

  <!-- Published API packages are the developer fallback; release candidates compile against exact runtime DLLs. -->
  <ItemGroup Condition="'$(UseExactSptRuntime)' != 'true'">
    <PackageReference Include="SPTushonka.Common" Version="$(SptPublishedApiBaseline)" />
    <PackageReference Include="SPTushonka.DI" Version="$(SptPublishedApiBaseline)" />
    <PackageReference Include="SPTushonka.Server.Core" Version="$(SptPublishedApiBaseline)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseExactSptRuntime)' == 'true'">
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SptRuntimeLibDir)/SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SptRuntimeLibDir)/SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SptRuntimeLibDir)/SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="JetBrains.Annotations"><HintPath>$(SptRuntimeLibDir)/JetBrains.Annotations.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(SptRuntimeLibDir)/SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ValidateExactSptRuntimeReferences" BeforeTargets="ResolveReferences" Condition="'$(UseExactSptRuntime)' == 'true'">
    <Error Condition="!Exists('$(SptRuntimeLibDir)/SPTarkov.Server.Core.dll')" Text="Exact SPT build requested but SPTarkov.Server.Core.dll is missing from $(SptRuntimeLibDir)" />
    <Error Condition="!Exists('$(SptRuntimeLibDir)/SPTarkov.Common.dll')" Text="Exact SPT build requested but SPTarkov.Common.dll is missing from $(SptRuntimeLibDir)" />
    <Error Condition="!Exists('$(SptRuntimeLibDir)/SPTarkov.DI.dll')" Text="Exact SPT build requested but SPTarkov.DI.dll is missing from $(SptRuntimeLibDir)" />
    <Error Condition="!Exists('$(SptRuntimeLibDir)/JetBrains.Annotations.dll')" Text="Exact SPT build requested but JetBrains.Annotations.dll is missing from $(SptRuntimeLibDir)" />
    <Error Condition="!Exists('$(SptRuntimeLibDir)/SemanticVersioning.dll')" Text="Exact SPT build requested but SemanticVersioning.dll is missing from $(SptRuntimeLibDir)" />
  </Target>

  <ItemGroup>
    <Content Include="..\manifests\campaign-manifest.json" Link="manifests\campaign-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\manifests\reward-policy.json" Link="manifests\reward-policy.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\manifests\runtime-manifest.json" Link="manifests\runtime-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\manifests\baseline-stock.json" Link="manifests\baseline-stock.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\db\base.json" Link="db\base.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\db\assort.json" Link="db\assort.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\db\questassort.json" Link="db\questassort.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\db\quests\*.json" Link="db\quests\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\db\locales\*.json" Link="db\locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
