<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>Admiral Trader Server</AssemblyName>
    <RootNamespace>AdmiralTrader.Server</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <SptRuntimeTarget>4.1.3</SptRuntimeTarget>
    <SptPublishedApiBaseline>4.1.3</SptPublishedApiBaseline>
    <UseExactSptRuntime Condition="'$(SptRuntimeLibDir)' != ''">true</UseExactSptRuntime>
    <UseExactSptRuntime Condition="'$(SptRuntimeLibDir)' == ''">false</UseExactSptRuntime>
  </PropertyGroup>

  <!-- SPT 4.1.3 is published under the SPTushonka.* NuGet package IDs while retaining
       SPTarkov.* assembly/namespace identities. CI therefore compiles directly against the
       4.1.3 package line; SptRuntimeLibDir remains available for byte-exact local runtime proof. -->
  <ItemGroup Condition="'$(UseExactSptRuntime)' != 'true'">
    <PackageReference Include="SPTushonka.Common" Version="$(SptPublishedApiBaseline)" />
    <PackageReference Include="SPTushonka.DI" Version="$(SptPublishedApiBaseline)" />
    <PackageReference Include="SPTushonka.Server.Core" Version="$(SptPublishedApiBaseline)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseExactSptRuntime)' == 'true'">
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptRuntimeLibDir)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptRuntimeLibDir)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptRuntimeLibDir)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptRuntimeLibDir)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="JetBrains.Annotations">
      <HintPath>$(SptRuntimeLibDir)\JetBrains.Annotations.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateExactSptRuntimeReferences" BeforeTargets="ResolveReferences" Condition="'$(UseExactSptRuntime)' == 'true'">
    <Error Condition="!Exists('$(SptRuntimeLibDir)\SPTarkov.Server.Core.dll')" Text="Exact SPT build requested but SPTarkov.Server.Core.dll is missing from SptRuntimeLibDir=$(SptRuntimeLibDir)" />
    <Error Condition="!Exists('$(SptRuntimeLibDir)\SPTarkov.Common.dll')" Text="Exact SPT build requested but SPTarkov.Common.dll is missing from SptRuntimeLibDir=$(SptRuntimeLibDir)" />
    <Error Condition="!Exists('$(SptRuntimeLibDir)\SPTarkov.DI.dll')" Text="Exact SPT build requested but SPTarkov.DI.dll is missing from SptRuntimeLibDir=$(SptRuntimeLibDir)" />
    <Error Condition="!Exists('$(SptRuntimeLibDir)\SemanticVersioning.dll')" Text="Exact SPT build requested but SemanticVersioning.dll is missing from SptRuntimeLibDir=$(SptRuntimeLibDir)" />
    <Error Condition="!Exists('$(SptRuntimeLibDir)\JetBrains.Annotations.dll')" Text="Exact SPT build requested but JetBrains.Annotations.dll is missing from SptRuntimeLibDir=$(SptRuntimeLibDir)" />
  </Target>

  <ItemGroup>
    <Content Include="..\manifests\campaign-manifest.json" Link="manifests\campaign-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\manifests\reward-policy.json" Link="manifests\reward-policy.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\manifests\runtime-manifest.json" Link="manifests\runtime-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\manifests\gameplay-policy.json" Link="manifests\gameplay-policy.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\manifests\baseline-stock.json" Link="manifests\baseline-stock.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\manifests\ammo-offer-policy.json" Link="manifests\ammo-offer-policy.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\manifests\identity-assets.json" Link="manifests\identity-assets.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\manifests\persistent-identities.json" Link="manifests\persistent-identities.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\d5c27bb3169f8dfbc13f6b69.jpg" Link="assets\d5c27bb3169f8dfbc13f6b69.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\db\base.json" Link="db\base.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\db\assort.json" Link="db\assort.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\db\questassort.json" Link="db\questassort.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\db\quests\*.json" Link="db\quests\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\db\locales\*.json" Link="db\locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
