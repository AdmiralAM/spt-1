<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>SPT Quest Planner Server</AssemblyName>
    <RootNamespace>SPTQuestPlanner.Server</RootNamespace>
    <Version>0.9.1</Version>
    <AssemblyVersion>0.9.1.0</AssemblyVersion>
    <FileVersion>0.9.1.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\PlannerDataContract.cs" Link="PlannerDataContract.cs" />
    <Compile Include="..\src\PlannerDomain.cs" Link="PlannerDomain.cs" />
    <Compile Include="..\src\PlannerTransportJson.cs" Link="PlannerTransportJson.cs" />
    <Compile Include="..\src\SptObjectReader.cs" Link="SptObjectReader.cs" />
    <Compile Include="..\src\QuestExtractor.cs" Link="QuestExtractor.cs" />
    <Compile Include="..\src\QuestObjectiveExtractor.cs" Link="QuestObjectiveExtractor.cs" />
    <Compile Include="..\src\ProfileProjection.cs" Link="ProfileProjection.cs" />
    <Compile Include="..\src\PlannerEvaluation.cs" Link="PlannerEvaluation.cs" />
    <Compile Include="..\src\InventoryProjection.cs" Link="InventoryProjection.cs" />
    <PackageReference Include="SPTarkov.Common" Version="4.1.2" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.2" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" />
  </ItemGroup>
</Project>
