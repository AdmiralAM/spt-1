<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>SPT Quest Planner Server</AssemblyName>
    <RootNamespace>SPTQuestPlanner.Server</RootNamespace>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\PlannerDataContract.cs" Link="PlannerDataContract.cs" />
    <Compile Include="..\src\PlannerDomain.cs" Link="PlannerDomain.cs" />
    <Compile Include="..\src\QuestExtractor.cs" Link="QuestExtractor.cs" />
    <Compile Include="..\src\ProfileProjection.cs" Link="ProfileProjection.cs" />
    <PackageReference Include="SPTushonka.Common" Version="4.1.3" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.3" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.3" />
  </ItemGroup>
</Project>
