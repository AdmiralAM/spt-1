<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Admiral Tactical HUD</AssemblyName>
    <RootNamespace>AdmiralTacticalHUD</RootNamespace>
    <Version>1.13.3</Version>
    <AssemblyVersion>1.13.3.0</AssemblyVersion>
    <FileVersion>1.13.3.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>..\..\..\deps\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\botcensus\*.png">
      <LogicalName>AdmiralTacticalHUD.BotCensus.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
